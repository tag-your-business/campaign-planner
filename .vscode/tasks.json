{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Backend: pytest watch",
            "type": "shell",
            "command": "poetry run ptw .",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Backend: uvicorn",
            "type": "shell",
            "command": "poetry run uvicorn app.main:app --reload",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start Dev Environment",
            "dependsOn": ["Backend: pytest watch", "Backend: uvicorn"],
            "dependsOrder": "parallel",
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "never"
            },
            "problemMatcher": []
        }
    ]
}
