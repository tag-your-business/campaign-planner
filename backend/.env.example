APP_NAME=Campaign Planner
DEBUG=false

# AI Provider Selection (openai, nvidia, or anthropic)
TEXT_GENERATION_PROVIDER=nvidia

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_TEXT_MODEL=claude-opus-4-8

# NVIDIA
NVIDIA_API_KEY=
NVIDIA_TEXT_MODEL=meta/llama-3.1-8b-instruct

# Data paths (defaults match repo structure)
DATA_DIR=data
REGISTRY_PATH=data/registry/company_registry.json
COMPANIES_DIR=data/companies
EVENTS_DIR=data/events
CAMPAIGNS_DIR=data/campaigns
LOGS_DIR=data/logs

# Generation Timing (Optional)
GENERATION_LEAD_DAYS=10
PUBLISH_LEAD_DAYS=3

# Scheduling (Optional)
GENERATE_CRON=0 8 * * *
PUBLISH_CRON=0 10 * * *

# Social Media API (Optional, required for publishing)
FACEBOOK_API_VERSION=v21.0
INSTAGRAM_API_VERSION=v21.0
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=

# Retry Settings (Optional)
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2
