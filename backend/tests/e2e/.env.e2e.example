# E2E Test Configuration
# Copy this file to .env.e2e and update with your actual credentials

# Enable E2E tests (set to 1 to run, 0 to skip)
RUN_E2E=0

# Facebook Configuration
E2E_FACEBOOK_PAGE_ID=your_facebook_page_id_here
E2E_FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token_here

# Instagram Configuration
E2E_INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here
E2E_INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# Note: Image URL is NOT needed - test will upload to Facebook first,
# then use the FB-hosted image URL for Instagram publishing
